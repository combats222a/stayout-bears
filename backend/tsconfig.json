{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,

    /* Единственный оставшийся .js-файл — db/migrations/0001_init.js.
       node-pg-migrate по конвенции проекта создаёт миграции как .js
       (см. migrate:create в package.json, флаг -j js) — сознательно
       не переводили в .ts, это не часть рантайм-графа приложения. */
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
